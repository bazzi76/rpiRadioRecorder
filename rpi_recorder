import RPi.GPIO as GPIO
import time
import subprocess
import threading
import sys
import signal
import os # <--- Serve per lanciare il comando vocale

# Configurazione PIN
BUTTON_PIN = 23
LED_PIN = 24
BUTTON_IP_PIN = 17 # <--- Nuovo pulsante per l'IP

GPIO.setmode(GPIO.BCM)
GPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(BUTTON_IP_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP) # <--- Configurato con pull-up
GPIO.setup(LED_PIN, GPIO.OUT)
GPIO.output(LED_PIN, GPIO.LOW)

print("Attivazione dello speaker di monitor...")
cmd_monitor = ["alsaloop", "-C", "plug:dsnoop:0", "-P", "plughw:0,0", "-c", "1", "-t", "80000"]
processo_monitor = subprocess.Popen(cmd_monitor)

registrando = False
processo_registrazione = None
stop_led_thread = False

def lampeggia_led():
    global stop_led_thread
    while not stop_led_thread:
        GPIO.output(LED_PIN, GPIO.HIGH)
        time.sleep(0.5)
        GPIO.output(LED_PIN, GPIO.LOW)
        time.sleep(0.5)

# FUNZIONE PER LEGGERE L'IP A VOCE
def pronuncia_ip():
    global processo_monitor
    print("Recupero indirizzo IP...")
    
    # 1. Recupera l'IP
    cmd_get_ip = "hostname -I | awk '{print $1}'"
    ip = subprocess.check_output(cmd_get_ip, shell=True).decode('utf-8').strip()
    testo = f"Il mio indirizzo i pi è {ip}" if ip else "Nessuna connessione di rete"
    
    # 2. Genera il file WAV
    print(f"Dico a voce: {testo}")
    subprocess.run(f"espeak-ng -v it -s 140 '{testo}' -w /tmp/ip.wav", shell=True)
    
    # 3. Killa RECONOSCIUTAMENTE alsaloop liberando ALSA
    if processo_monitor:
        print("Spegnimento temporaneo del monitor...")
        # Chiudiamo sia la shell (se rimasta) che il processo direttamente
        subprocess.run(f"pkill -P {processo_monitor.pid}", shell=True)
        processo_monitor.terminate()
        processo_monitor.wait() # Forza l'attesa del rilascio hardware
        time.sleep(0.5) # Un piccolo respiro per ALSA
    
    # 4. Riproduci l'IP a scheda audio totalmente scarica
    subprocess.run("aplay -D plughw:0,0 /tmp/ip.wav", shell=True)
    subprocess.run("rm -f /tmp/ip.wav", shell=True)
    
    # 5. Ripristina il monitor della radio
    print("Ripristino dello speaker di monitor...")
    cmd_monitor = ["alsaloop", "-C", "plug:dsnoop:0", "-P", "plughw:0,0", "-c", "1", "-t", "80000"]
    processo_monitor = subprocess.Popen(cmd_monitor)

# FUNZIONE DI CHIUSURA PULITA
def chiusura_pulita(signum, frame):
    print("\nChiusura pulita ricevuta...")
    global stop_led_thread, processo_monitor, processo_registrazione
    
    stop_led_thread = True
    if processo_monitor:
        processo_monitor.terminate()
    if processo_registrazione:
        subprocess.run("pkill -P " + str(processo_registrazione.pid), shell=True)
        processo_registrazione.terminate()

    GPIO.output(LED_PIN, GPIO.LOW)
    GPIO.cleanup()
    sys.exit(0)

signal.signal(signal.SIGINT, chiusura_pulita)
signal.signal(signal.SIGTERM, chiusura_pulita)

print("Sistema pronto. Pulsante 23: Rec | Pulsante 17: Dici IP")

try:
    while True:
        stato_pulsante_rec = GPIO.input(BUTTON_PIN)
        stato_pulsante_ip = GPIO.input(BUTTON_IP_PIN) # <--- Legge il nuovo pulsante

	# GESTIONE PULSANTE IP (Ottimizzata)
        if stato_pulsante_ip == False:
            # Controlla se il thread IP è già attivo per evitare doppie letture
            # Cerca se esiste già un thread chiamato "IP_Thread"
            if not any(t.name == "IP_Thread" for t in threading.enumerate()):
                ip_thread = threading.Thread(target=pronuncia_ip, name="IP_Thread")
                ip_thread.start()
            time.sleep(1.5) # Debounce più lungo per dare tempo al dito di staccarsi

        # GESTIONE PULSANTE REGISTRAZIONE
        if stato_pulsante_rec == False:
            if not registrando:
                print("--- Avvio Registrazione ---")
                nome_file = time.strftime("/home/gmattei/rpiRadioRecorder/recordings/radio_%Y%m%d_%H%M%S.mp3")
                comando_mp3 = f"arecord -D plug:dsnoop:0 -c 1 -r 48000 -f S16_LE -B 500000 | lame -b 64 - {nome_file}"
                processo_registrazione = subprocess.Popen(comando_mp3, shell=True)

                registrando = True
                print(f"Sto registrando in MP3: {nome_file}")

                stop_led_thread = False
                led_thread = threading.Thread(target=lampeggia_led)
                led_thread.daemon = True
                led_thread.start()
            else:
                print("--- Arresto Registrazione ---")
                if processo_registrazione:
                    subprocess.run("pkill -P " + str(processo_registrazione.pid), shell=True)
                    processo_registrazione.terminate()
                    processo_registrazione.wait() # Aspetta che il file MP3 venga chiuso del tutto

                registrando = False
                stop_led_thread = True
                GPIO.output(LED_PIN, GPIO.LOW)
                print("Registrazione interrotta. Avvio elaborazione audio con SoX...")

                # FUNZIONE PER L'ELABORAZIONE IN UN THREAD SEPARATO
                # Usiamo un thread così il led smette di lampeggiare subito e l'interfaccia non si blocca
                def elabora_audio(file_grezzo):
                    file_temporaneo = file_grezzo.replace(".mp3", "_temp.mp3")
                    
                    # Il tuo comando SoX personalizzato
                    comando_sox = (
                        f"sox '{file_grezzo}' '{file_temporaneo}' "
                        f"silence -l 1 0.3 1% -1 0.5 1% "
                        f"highpass 300 lowpass 3400 "
                        f"compand 0.3,1 -90,-90,-70,-70,-60,-20,0,0 -5"
                    )
                    
                    try:
                        # Esegue il filtraggio
                        subprocess.run(comando_sox, shell=True, check=True)
                        # Sovrascrive il file originale con quello pulito
                        os.replace(file_temporaneo, file_grezzo)
                        print(f"Elaborazione completata con successo per: {file_grezzo}")
                    except subprocess.CalledProcessError as e:
                        print(f"Errore durante l'elaborazione SoX: {e}")
                        # In caso di errore, rimuove il temporaneo se esiste per non sporcare la cartella
                        if os.path.exists(file_temporaneo):
                            os.remove(file_temporaneo)

                # Avvia l'elaborazione SoX in background
                threading.Thread(target=elabora_audio, args=(nome_file,)).start()

            time.sleep(1) # Debounce

        time.sleep(0.1)

except Exception as e:
    print(f"Errore imprevisto: {e}")
    chiusura_pulita(None, None)
